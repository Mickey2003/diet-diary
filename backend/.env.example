# ===== 模型配置（也可以在网页“设置”页里填写，设置页的值优先） =====
# 可选：mock | openai | dashscope | zhipu | siliconflow | deepseek | moonshot | ollama | custom
# mock = 离线演示模式，不调用任何模型，适合先跑通界面
LLM_PROVIDER=mock
# 自定义 / 覆盖预设的 OpenAI 兼容地址，例如 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 密钥只放在这里或设置页，绝不要写进前端代码或提交到 git
LLM_API_KEY=
# 文本模型（查询解释、周报）与视觉模型（图片识别），留空则使用供应商预设
LLM_TEXT_MODEL=
# 快速模型：用于查询规划、结果解释、记忆抽取、分享文案（对延迟敏感的短任务），留空则与文本模型相同
LLM_FAST_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT=60

# ===== 登录账户（首次启动时若数据库中没有用户则据此创建） =====
# 留空 ADMIN_PASSWORD 则自动生成随机密码，写入 backend/data/initial_password.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 其他 =====
TIMEZONE=Asia/Shanghai
# 通知定时任务（每日提醒 / 每日小结 / 周报推送），1 开启 0 关闭
ENABLE_SCHEDULER=1
MAX_IMAGE_SIDE=1280
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=sqlite:///./data/diet.db
