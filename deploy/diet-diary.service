[Unit]
Description=Diet Diary backend (FastAPI, serves built frontend)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/backend
EnvironmentFile=__ROOT__/backend/.env
# 只监听本机，由 Caddy 反向代理对外提供 HTTPS
ExecStart=__ROOT__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
